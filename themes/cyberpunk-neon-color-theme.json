  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#005faf", "fontStyle": "italic" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#f57800" }
    },
    {
      "name": "String escapes and interpolation placeholders",
      "scope": ["constant.character.escape", "constant.character.format.placeholder", "punctuation.definition.template-expression"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Numbers and language constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "keyword.other.unit"],
      "settings": { "foreground": "#f57800" }
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "keyword.control", "keyword.other"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "punctuation.definition", "punctuation.separator", "punctuation.terminator", "punctuation.accessor", "punctuation.section", "meta.brace", "punctuation.definition.tag"],
      "settings": { "foreground": "#0abdc6" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Macros",
      "scope": ["entity.name.function.macro"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Types, classes, interfaces",
      "scope": ["entity.name.type", "entity.name.class", "entity.name.struct", "entity.name.enum", "entity.name.union", "entity.name.trait", "entity.name.interface", "entity.other.inherited-class", "support.type", "support.class"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Tags",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Variables and parameters",
      "scope": ["variable", "variable.other", "variable.parameter", "support.variable"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Object properties and JSON keys",
      "scope": ["variable.other.property", "variable.other.object.property", "variable.other.member", "support.type.property-name"],
      "settings": { "foreground": "#0abdc6" }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": ["variable.language"],
      "settings": { "foreground": "#ea00d9", "fontStyle": "italic" }
    },
    {
      "name": "Namespaces and modules",
      "scope": ["entity.name.namespace", "entity.name.module", "entity.name.scope-resolution"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Preprocessor",
      "scope": ["meta.preprocessor", "keyword.control.directive", "punctuation.definition.directive"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Decorators and attributes",
      "scope": ["entity.name.function.decorator", "entity.name.decorator", "meta.decorator", "punctuation.decorator", "punctuation.definition.decorator", "meta.attribute", "punctuation.definition.attribute"],
      "settings": { "foreground": "#b854de" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": { "foreground": "#ff0000" }
    },
    {
      "name": "Markup: headings",
      "scope": ["markup.heading", "entity.name.section", "punctuation.definition.heading"],
      "settings": { "foreground": "#f57800", "fontStyle": "bold" }
    },
    {
      "name": "Markup: bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#d7d7d5", "fontStyle": "bold" }
    },
    {
      "name": "Markup: italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#d7d7d5", "fontStyle": "italic" }
    },
    {
      "name": "Markup: strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#0abdc6", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markup: blockquote text",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#0abdc6", "fontStyle": "italic" }
    },
    {
      "name": "Markup: blockquote and list markers",
      "scope": ["punctuation.definition.quote.begin.markdown", "punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown", "beginning.punctuation.definition.quote.markdown", "markup.list.numbered.bullet"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Markup: inline code",
      "scope": ["markup.inline.raw"],
      "settings": { "foreground": "#f57800" }
    },
    {
      "name": "Markup: fenced and raw block content",
      "scope": ["markup.fenced_code.block", "markup.raw.block"],
      "settings": { "foreground": "#0abdc6" }
    },
    {
      "name": "Markup: fence delimiters and language info",
      "scope": ["punctuation.definition.markdown", "punctuation.definition.raw.markdown", "fenced_code.block.language"],
      "settings": { "foreground": "#ea00d9" }
    },
    {
      "name": "Markup: links",
      "scope": ["markup.underline.link", "string.other.link", "constant.other.reference.link.markdown"],
      "settings": { "foreground": "#0abdc6", "fontStyle": "underline" }
    },
    {
      "name": "Markup: horizontal rule",
      "scope": ["meta.separator", "markup.separator", "punctuation.definition.separator.markdown"],
      "settings": { "foreground": "#ea00d9", "fontStyle": "bold" }
    },
    {
      "name": "Markup: inserted",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#00ff00" }
    },
    {
      "name": "Markup: deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff0000" }
    },
    {
      "name": "Markup: changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#f57800" }
    }
  ],
  "semanticTokenColors": {
    "keyword": "#ea00d9",
    "operator": "#ea00d9",
    "function": "#ea00d9",
    "method": "#ea00d9",
    "type": "#ea00d9",
    "class": "#ea00d9",
    "struct": "#ea00d9",
    "interface": "#ea00d9",
    "enum": "#ea00d9",
    "typeParameter": "#ea00d9",
    "enumMember": "#f57800",
    "variable": "#b854de",
    "parameter": "#b854de",
    "property": "#0abdc6",
    "string": "#f57800",
    "number": "#f57800",
    "comment": { "foreground": "#005faf", "italic": true },
    "namespace": "#b854de",
    "decorator": "#b854de",
    "macro": "#b854de",
    "selfParameter": { "foreground": "#ea00d9", "italic": true }
  }
}
